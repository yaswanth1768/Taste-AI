# TasteAI Environment Configuration

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# For local SQLite development (default fallback):
DATABASE_URL=sqlite:///./tasteai.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tasteaidb

# External APIs (Optional - Local Datasets provide full standalone functionality)
TMDB_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Server Configuration
HOST=0.0.0.0
PORT=8000
